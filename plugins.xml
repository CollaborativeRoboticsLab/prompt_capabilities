            A plugin that prompts the current manipulator Cartesian pose
        </description>
    </class>
    <class type="capabilities2_runner::PromptCurrentJointPoseRunner" base_class_type="capabilities2_runner::RunnerBase">
        <description>
            A plugin that prompts the current manipulator joint state
        </description>
    </class>
    <class type="capabilities2_runner::PromptGripperStateRunner" base_class_type="capabilities2_runner::RunnerBase">
        <description>
            A plugin that prompts the current gripper state
        </description>
    </class>
    <class type="capabilities2_runner::PromptTextRunner" base_class_type="capabilities2_runner::RunnerBase">
        <description>
